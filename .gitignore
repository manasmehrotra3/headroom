# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Xcode's build cache for `npm run ios:sim`.
/.ios-build

# Generated native folders. `npm run apk` rebuilds android/ from app.json and plugins/ with
# `prebuild --clean`, so it is never edited by hand and never committed.
/ios
/android

# Gradle build output for the local Expo modules in modules/. These are regenerated by every
# build and are full of absolute paths from whichever machine built them.
modules/*/android/build/
modules/*/android/.cxx/
targets/*/build/
.gradle/

# Native
.kotlin/
*.orig.*
*.hprof
local.properties

# Build outputs, in case one is copied out of android/ to share or install
*.apk
*.aab

# Signing keys and secrets. The release key lives in ~/keys and its passwords in
# ~/.gradle/gradle.properties, both outside this repo; these rules are the backstop in case a
# copy ever lands here. Losing control of the key means someone else can sign updates.
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
gradle.properties

# Environment files. The template only ignored .env*.local, which let a plain .env through.
# .env.example documents the variables and holds no values, so it stays committed.
.env
.env.*
!.env.example

# Personal health data. Everything stays on the phone, so a database pulled off the device for
# debugging, or a backup export saved into this folder, must never reach git.
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*-backup-*.json

# Metro
.metro-health-check*

# Tests
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Editors, agents and OS
.vscode/
.idea/
.DS_Store
.claude/settings.local.json

# typescript
*.tsbuildinfo
