{
  "expo": {
    "name": "Headroom",
    "slug": "headroom",
    "version": "0.19.1",
    "scheme": "headroom",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101418",
    "ios": {
      "bundleIdentifier": "com.manasmehrotra.headroom",
      "buildNumber": "23",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.manasmehrotra.headroom"
        ]
      }
    },
    "android": {
      "package": "com.manasmehrotra.headroom",
      "versionCode": 23,
      "adaptiveIcon": {
        "backgroundColor": "#0E0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withReleaseSigning",
      "expo-background-task",
      "expo-sharing",
      "react-native-health-connect",
      "./plugins/withHealthPermissions",
      [
        "expo-camera",
        {
          "cameraPermission": "Used only to scan food barcodes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used only to add progress photos, which stay on this phone.",
          "cameraPermission": "Used only to take progress photos."
        }
      ],
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#90CDFF"
        }
      ],
      "./plugins/withStepsWidget",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Headroom reads the workouts, heart rate, sleep, steps, weight and VO2 max that Garmin Connect saves to Apple Health, to plan your training and score your recovery. It never writes to Apple Health, and nothing leaves this iPhone.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "@bacons/apple-targets",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101418"
    }
  }
}
